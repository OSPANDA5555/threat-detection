# ==============================================================================
# AUTONOMOUS THREAT-HUNTING COPILOT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# DO NOT COMMIT REAL API KEYS, PASSWORDS, OR SECRETS TO GIT.
# COPY THIS FILE TO .env AND FILL IN YOUR ENVIRONMENT VALUES.

# SYSTEM & API SETTINGS
PROJECT_NAME="Autonomous Threat-Hunting Copilot"
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS & NETWORKING
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:8000"]
HOST=0.0.0.0
PORT=8000

# DATABASE CONFIGURATION
POSTGRES_SERVER=db
POSTGRES_USER=threat_hunter
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=threat_hunting_db
POSTGRES_PORT=5432

# AUTONOMOUS HUNTING ENGINE SAFETY BOUNDS
MAX_AUTONOMY_ITERATIONS=5
MAX_TOOL_CALLS_PER_HUNT=10
MAX_EVENTS_PER_TOOL_CALL=1000
TOOL_EXECUTION_TIMEOUT_SECONDS=300
MAX_CONSECUTIVE_TOOL_ERRORS=3

# OPTIONAL EXTERNAL LLM PROVIDER API KEYS
# (DEFAULT FALLBACK IS DETERMINISTIC EMBEDDED GROUNDED REASONING ENGINE)
LLM_PROVIDER=embedded
OPENAI_API_KEY=
GEMINI_API_KEY=
