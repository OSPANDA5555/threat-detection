# ==============================================================================
# AUTONOMOUS THREAT-HUNTING COPILOT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# DO NOT COMMIT REAL API KEYS, PASSWORDS, OR SECRETS TO GIT.
# COPY THIS FILE TO .env AND POPULATE WITH SECURE, ENVIRONMENT-SPECIFIC VALUES.

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & API SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="Autonomous Threat-Hunting Copilot"
ENVIRONMENT=production
LOG_LEVEL=INFO
API_V1_STR="/api/v1"
DEMO_MODE=false

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECURITY (SERVER-SIDE SECRETS)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-secure-random-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Telemetry shipper authentication API Key (Agent -> Backend)
SOC_AGENT_API_KEY=change-this-to-a-secure-random-agent-api-key

# Optional default user credential overrides for production bootstrap
ADMIN_PASSWORD=change_this_admin_password
ANALYST_PASSWORD=change_this_analyst_password

# ------------------------------------------------------------------------------
# 3. CORS & NETWORKING
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (never use "*" with credentials)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 4. RATE LIMITING & PAYLOAD BOUNDS
# ------------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_SIZE_MB=25

# ------------------------------------------------------------------------------
# 5. AUTONOMOUS HUNTING ENGINE SAFETY CAPS
# ------------------------------------------------------------------------------
MAX_AUTONOMY_ITERATIONS=5
MAX_TOOL_CALLS_PER_HUNT=10
MAX_TOOL_RESULT_COUNT=500
TOOL_TIMEOUT_SECONDS=5.0
ENFORCE_READ_ONLY=true
MAX_CONSECUTIVE_TOOL_ERRORS=3
HUNT_TIMEOUT_SECONDS=300.0

# ------------------------------------------------------------------------------
# 6. OPTIONAL EXTERNAL AI PROVIDER INTEGRATION
# ------------------------------------------------------------------------------
# Set to 'embedded' for the self-contained deterministic SOC investigator engine.
LLM_PROVIDER=embedded
OPENAI_API_KEY=
GEMINI_API_KEY=

